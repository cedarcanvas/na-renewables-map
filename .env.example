# Free key from https://www.eia.gov/opendata/register.php
# Without it the pipeline uses EIA's daily bulk CSV.
EIA_API_KEY=

# Optional: PJM Data Miner API key (PJM Account Manager access "Data Miner 2 Non-Member
# API", then a key from https://apiportal.pjm.com) for PJM's live hourly fuel mix.
# Without it PJM stays on EIA-930. Data Miner's terms: a non-member key is for internal
# use only; publishing data from it, or derived from it, needs PJM membership.
PJM_API_KEY=
