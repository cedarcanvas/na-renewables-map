# Free key from https://www.eia.gov/opendata/register.php
# Without it the pipeline uses EIA's daily bulk CSV.
EIA_API_KEY=

# Optional: free PJM Data Miner API key (sign up at https://apiportal.pjm.com) for PJM's live
# fuel mix. Without it, PJM stays on EIA-930 and runs up to a day behind.
PJM_API_KEY=
